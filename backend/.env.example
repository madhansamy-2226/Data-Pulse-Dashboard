# ==========================================
# SalesPulse Analytics - Environment Configuration
# ==========================================

# Django Configuration
SECRET_KEY=django-insecure-salespulse-production-key-replace-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------
# Supabase PostgreSQL Configuration
# ------------------------------------------
# Option A: Direct Connection URL (Recommended)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Example:
# DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.bizhnakccezfgmbhgjry.supabase.co:5432/postgres

# Option B: Transaction / Session Pooler URL (For Serverless & High Concurrency)
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Example:
# DATABASE_URL=postgresql://postgres.bizhnakccezfgmbhgjry:YOUR_SUPABASE_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------
# Redis & Celery (Optional - fallback enabled)
# ------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
