# Django Core Settings
SECRET_KEY=django-insecure-salespulse-secret-key-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings (PostgreSQL or leave blank for local SQLite fallback)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=salespulse_db
DB_USER=salespulse_user
DB_PASSWORD=salespulse_password
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Email / Celery Beat Notifications (Optional for local testing)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SalesPulse Analytics <no-reply@salespulse.dev>
